     # kill keyboard and estop machine before closing
+    def _keep_enabled_on_exit(self):
+        """[EMC] KEEP_ENABLED_ON_EXIT: the machine stays as it is at the GUI's exit (no Machine
+        off, no E-stop; task's shutdown leaves motion enabled too) and a machine found on at
+        the start is left on. For machines whose axes keep their state across sessions, e.g.
+        absolute servos, as KMotionCNC leaves them. Off by default: the usual exit."""
+        try:
+            v = linuxcnc.ini(os.environ["INI_FILE_NAME"]).find("EMC", "KEEP_ENABLED_ON_EXIT")
+        except Exception:
+            return False
+        return bool(v) and v.strip() not in ("0", "")
