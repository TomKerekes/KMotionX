+void CHANGE_TOOL_NUMBER(int pocket) {
     maybe_new_line();
     if(parse_state.interp_error) return;
+    // KMotionX: M61 Qn puts tool n in the spindle without a change, and what follows is cut
+    // with it - an M6 remapped to the board's tool change sets the tool this way. The renderer
+    // records it as it does an M6, so the preview's vertices carry the right tool (the Stock
+    // cuts with its shape). Q0 is no tool.
+    int toolno = pocket > 0 ? GET_EXTERNAL_TOOL_TABLE(pocket).toolno : 0;
+    parse_state.canon->change_tool(toolno);
 }
 
