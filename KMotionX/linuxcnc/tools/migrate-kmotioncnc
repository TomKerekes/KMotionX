            text = self.read_text(THREELINK / "kmotion-3link.ini")
            m = re.search(r"\[GAMEPAD\][\s\S]*?(?=\n\[|\Z)", text)
            if m: w(""); w(m.group(0).rstrip())
        (self.out / f"{self.name}.ini").write_text("\n".join(L) + "\n")

    def compile_check(self):
        tcc = ROOT / "bin" / "tcc67"
        dsp = Path.home() / ".kmotionx" / "DSP_KFLOP" / "DSPKFLOP.out"
        if not dsp.exists(): dsp = ROOT / "DSP_KFLOP" / "DSPKFLOP.out"
        if not tcc.exists() or not dsp.exists():
            self.warn("No tcc67 or firmware image found: the programs were not compile-checked"); return
        files = sorted(self.out / p for p in self.thread_programs | {"Home.c", "Loop.c"} if (self.out / p).exists())
        bad = 0
        for f in files:
            cmd = [str(tcc), "-text", "80050000", "-g", "-nostdinc", "-I", str(dsp.parent), "-I", str(f.parent),
                   "-I", str(self.out), "-I", str(self.cprog), "-I", str(Path.home() / ".kmotionx" / "C Programs"),
                   "-o", "/dev/null", str(f), str(dsp)]
            r = subprocess.run(cmd, capture_output=True, text=True)
            if r.returncode != 0:
                bad += 1
                err = (r.stdout + r.stderr).strip().split("\n")[0]
                self.warn(f"`{f.relative_to(self.out)}` does not compile for the KFLOP: {err}")
        self.note(f"Compile check (tcc67, KFLOP image): {len(files)} programs, {bad} with errors")

    def write_md(self):
        L = [f"# {self.name}: converted from KMotionCNC", "",
             f"Made by `linuxcnc/tools/migrate-kmotioncnc` on {datetime.date.today()} from `{self.install}`.",
             "Start it with the desktop icon \"LinuxCNC (" + self.name + ")\" or",
             f"`~/linuxcnc-dev/scripts/linuxcnc {self.out}/{self.name}.ini`.", ""]
        if self.warnings:
            L += ["## Needs a look", ""] + [f"- {s}" for s in self.warnings] + [""]
        L += ["## What was taken", ""] + [f"- {s}" for s in self.notes] + ["",
              "## Not converted by design", "",
              "- M0, M1, M2 and M6 actions: LinuxCNC runs those codes itself (M6 through its tool-change pins).",
              "- KMotionCNC's 8 special actions (program end and the like).",
              "- Rigid tapping (TAP_PROGRAM): copy the bench's Tap.c if the spindle has an encoder.",
              "- Probing: no probe bit in a KMotionCNC setup; set [KMOTION] PROBE_BIT yourself.",
              "- The screen script, the jog step sizes, the DRO settings: gmoccapy has its own.", ""]
        (self.out / "MIGRATION.md").write_text("\n".join(L))


def write_icon(name, out):
    """a desktop launcher, as install-desktop-icons.sh makes them"""
    motion = LCNC / "kmotion-motion" / "kmotion-motion"
    lcnc_dir = ""
    try:
        r = subprocess.run(["readelf", "-d", str(motion)], capture_output=True, text=True)
        for m in re.finditer(r"R(?:UN)?PATH.*\[(.*)\]", r.stdout):
            for p in m.group(1).split(":"):
                cand = Path(p).parent
                if (cand / "scripts" / "linuxcnc").exists(): lcnc_dir = str(cand); break
            if lcnc_dir: break
    except OSError:
        pass
    if not lcnc_dir: lcnc_dir = os.environ.get("LINUXCNC_DIR", str(Path.home() / "linuxcnc-dev"))
    linuxcnc = Path(lcnc_dir) / "scripts" / "linuxcnc"
    data = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local" / "share"))
    apps = data / "applications"; apps.mkdir(parents=True, exist_ok=True)
    desktop = Path(subprocess.run(["xdg-user-dir", "DESKTOP"], capture_output=True, text=True).stdout.strip() or Path.home() / "Desktop")
    desktop.mkdir(parents=True, exist_ok=True)
    text = ("[Desktop Entry]\nVersion=1.0\nType=Application\n"
            f"Name=LinuxCNC ({name})\nComment=LinuxCNC on a KFLOP or Kogna through KMotion: {name}, converted from KMotionCNC\n"
            f"Exec=\"{linuxcnc}\" \"{out / (name + '.ini')}\"\nIcon=linuxcncicon\nTerminal=false\nStartupNotify=false\n"
            "Categories=Science;Engineering;X-CNC;\nKeywords=cnc;linuxcnc;kmotion;\n")
    for p in (apps / f"linuxcnc-{name}.desktop", desktop / f"linuxcnc-{name}.desktop"):
        p.write_text(text)
        p.chmod(0o755)
        subprocess.run(["gio", "set", "-t", "string", str(p), "metadata::xfce-exe-checksum",
                        subprocess.run(["sha256sum", str(p)], capture_output=True, text=True).stdout.split()[0]],
                       capture_output=True)
        subprocess.run(["gio", "set", "-t", "string", str(p), "metadata::trusted", "true"], capture_output=True)
    subprocess.run(["update-desktop-database", str(apps)], capture_output=True)
    return desktop / f"linuxcnc-{name}.desktop"


def find_installs():
    found = []
    for base in (Path("/mnt/kmotion"), Path("/media"), Path.home()):
        if not base.exists(): continue
        for p in sorted(base.glob("*")):
            if p.resolve() == ROOT.resolve(): continue            # this checkout has the files too
            if (p / "KMotion" / "Data" / "GCodeConfigCNC.txt").exists(): found.append(p)
    return sorted(found, key=lambda p: (p / "KMotion" / "Data" / "GCodeConfigCNC.txt").stat().st_mtime, reverse=True)


def main():
    ap = argparse.ArgumentParser(description="a LinuxCNC configuration from a KMotionCNC setup")
    ap.add_argument("--install", help="the KMotion installation folder (has KMotion/Data and C Programs)")
    ap.add_argument("--name", help="the configuration's name: configs/<name>")
    ap.add_argument("--force", action="store_true", help="replace an existing configs/<name>")
    ap.add_argument("--no-icon", action="store_true", help="no desktop launcher")
    ap.add_argument("--yes", action="store_true", help="no questions: the defaults")
    ap.add_argument("--programs-dir", action="append", default=[], metavar="DIR",
                    help="a folder searched (3 levels deep) for the folders the setup names by absolute Windows paths; "
                         "the shared folder, the install's parent and your home are searched anyway")
    ap.add_argument("--map", action="append", default=[], metavar="WINFOLDER=DIR",
                    help="where a Windows folder the setup names is here, e.g. "
                         "--map 'C:\\Users\\Carl\\Desktop\\5x5 K6=/mnt/kmotion/5x5 K6' (repeatable)")
    args = ap.parse_args()
    install = args.install
    if not install:
        found = find_installs()
        if not found:
            sys.exit("no KMotion installation found: pass --install <folder> (one with KMotion/Data/GCodeConfigCNC.txt "
                     "and C Programs/; on a VM, the Windows install through the shared folder, /mnt/kmotion/...)")
        install = str(found[0])
        if len(found) > 1 and not args.yes:
            print("KMotion installations found:")
            for i, p in enumerate(found): print(f"  {i + 1}. {p}")
            s = input(f"which [1]: ").strip()
            if s: install = str(found[int(s) - 1])
    install = Path(install)
    if not (install / "KMotion" / "Data" / "GCodeConfigCNC.txt").exists():
        sys.exit(f"{install} has no KMotion/Data/GCodeConfigCNC.txt (a KMotionCNC setup)")
    default_name = re.sub(r"[^A-Za-z0-9._-]+", "-", install.name).strip("-").lower() or "migrated"
    name = args.name
    if not name:
        if args.yes: name = default_name
        else:
            name = input(f"name of the new configuration (configs/<name>) [{default_name}]: ").strip() or default_name
    name = re.sub(r"[^A-Za-z0-9._-]+", "-", name).strip("-")
    out = LCNC / "configs" / name
    print(f"converting {install}\n       to {out}")
    m = Migration(install, name, out, args.force, args.programs_dir, args.map, interactive=not args.yes)
    m.run()
    icon = None
    if not args.no_icon:
        icon = write_icon(name, out)
    print(f"\ndone: {out}")
    print(f"  {len(m.notes)} items taken, {len(m.warnings)} to look at: see {out / 'MIGRATION.md'}")
    if icon: print(f"  launcher: {icon}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
