# A USB game pad for jogging, as KMotionCNC's joystick jog: gamepad-input (panels/, our own
# reader of the Linux input device, with hal_input's pin names) reads the pad, halui turns
# the sticks into jogs of the CAD axes (world mode: through the kinematics).
# Loaded as a second [DISPLAY] POSTGUI_HALFILE, after gmoccapy-postgui.hal; the pad is
# described in the ini's [GAMEPAD] section (its name, which stick axis moves which machine
# axis, the dead-man and the fast button, the speeds). Nothing moves unless the dead-man
# button is held. The jog follows the stick proportionally; the machine must be on and in
# manual mode (the GUI's jog page).
#
# The pad's axis and button names are hal_input's: once the pad is plugged in,
#   halcmd show pin input          (with LinuxCNC running)
# lists them (abs-x-position, abs-y-position, abs-rx-..., abs-ry-..., abs-z-..., abs-rz-..., abs-hat0x-...;
# btn-a, btn-b, btn-x, btn-y, btn-tl, btn-tr, btn-start, btn-select ...), and
#   cat /proc/bus/input/devices    (the N: Name= line) gives the name for [GAMEPAD] NAME.
# The user must be allowed to read the pad's /dev/input/event device: the udev rule
# usb/etc/udev/rules.d/11.joystick.rules (the install script puts it in place).
#
# gamepad-input reads the sticks' state when it opens the pad (hal_input did not: every
# stick read -1, full deflection, until its first event, and the dead-man alone would have
# released a full negative jog on every axis). As a second guard each axis arms itself only
# once its stick has been seen inside the centre band (the flipflop below); until then its
# mux stays at zero whatever the dead-man says.

# gamepad-input (panels/): the pad's pins, from the device when a pad is attached (taken
# or let go at any time, its state read when it is opened), at rest when none is -
# LinuxCNC starts either way
loadusr -Wn input ../../panels/gamepad-input --deadband [GAMEPAD]DEADBAND

# the pad's logic runs in its own thread (the kmotion configs have no other)
loadrt threads name1=pad-thread period1=20000000
# the sticks, with a sign and gain per axis (a pad's Y stick reads negative when pushed away)
loadrt scale count=3
# the arming latch per axis: |stick| (abs) below the band (comp) sets a flipflop
loadrt abs count=3
loadrt comp count=3
loadrt flipflop count=3
loadrt and2 count=3
# the dead-man: the stick reaches halui only while the button is held and the axis is
# armed; and the speed choice
loadrt mux2 count=4
addf scale.0 pad-thread
addf scale.1 pad-thread
addf scale.2 pad-thread
addf abs.0 pad-thread
addf abs.1 pad-thread
addf abs.2 pad-thread
addf comp.0 pad-thread
addf comp.1 pad-thread
addf comp.2 pad-thread
addf flipflop.0 pad-thread
addf flipflop.1 pad-thread
addf flipflop.2 pad-thread
addf and2.0 pad-thread
addf and2.1 pad-thread
addf and2.2 pad-thread
addf mux2.0 pad-thread
addf mux2.1 pad-thread
addf mux2.2 pad-thread
addf mux2.3 pad-thread

setp scale.0.gain [GAMEPAD]X_GAIN
setp scale.1.gain [GAMEPAD]Y_GAIN
setp scale.2.gain [GAMEPAD]Z_GAIN
# (an ini value stands for the rest of a word: halcmd takes everything up to the next
# space as the key's name, so the keys hold the whole pin suffix, abs-x-position)
net pad-x-raw input.0.[GAMEPAD]X_AXIS => scale.0.in
net pad-y-raw input.0.[GAMEPAD]Y_AXIS => scale.1.in
net pad-z-raw input.0.[GAMEPAD]Z_AXIS => scale.2.in

# armed: the stick has been inside the centre band at least once (comp: in1 > in0, with
# in0 = |stick| and in1 = the band); the flipflop keeps it
net pad-x scale.0.out => mux2.0.in1 abs.0.in
net pad-y scale.1.out => mux2.1.in1 abs.1.in
net pad-z scale.2.out => mux2.2.in1 abs.2.in
net pad-x-abs abs.0.out => comp.0.in0
net pad-y-abs abs.1.out => comp.1.in0
net pad-z-abs abs.2.out => comp.2.in0
setp comp.0.in1 0.3
setp comp.1.in1 0.3
setp comp.2.in1 0.3
net pad-x-centred comp.0.out => flipflop.0.set
net pad-y-centred comp.1.out => flipflop.1.set
net pad-z-centred comp.2.out => flipflop.2.set
net pad-x-armed flipflop.0.out => and2.0.in0
net pad-y-armed flipflop.1.out => and2.1.in0
net pad-z-armed flipflop.2.out => and2.2.in0
net pad-enable input.0.[GAMEPAD]ENABLE => and2.0.in1 and2.1.in1 and2.2.in1
net pad-x-go and2.0.out => mux2.0.sel
net pad-y-go and2.1.out => mux2.1.sel
net pad-z-go and2.2.out => mux2.2.sel
setp mux2.0.in0 0
setp mux2.1.in0 0
setp mux2.2.in0 0
net pad-jog-x mux2.0.out => halui.axis.x.analog
net pad-jog-y mux2.1.out => halui.axis.y.analog
net pad-jog-z mux2.2.out => halui.axis.z.analog

# the speed the full stick gives, in machine units per minute: slow, or fast while the
# fast button is held. The dead band is the reader's (above, a soft one: the stick's reading
# rises from 0 at the band's edge); halui's own, a step, is left only to swallow the residue
net pad-fast input.0.[GAMEPAD]FAST => mux2.3.sel
setp mux2.3.in0 [GAMEPAD]SLOW_SPEED
setp mux2.3.in1 [GAMEPAD]FAST_SPEED
net pad-speed mux2.3.out => halui.axis.jog-speed
setp halui.axis.jog-deadband 0.01

start
