# kmotion-3link: HAL after gmoccapy is up ([HAL] POSTGUI_HALFILE). The signal gui-ready marks
# the end of the GUI's start-up for autostart.py, which turns the machine on only then (the
# panel's own nets are in panels/kmotion-panel.hal, run by gladevcp itself)
newsig gui-ready bit
sets gui-ready 1
# the fake spindle's measured speed and at-speed state for the GUI (kmotion-3link.ini: SPINDLE_*)
net spindle-rpm-measured kmotion.spindle-rpm-abs => gmoccapy.spindle_feedback_bar
net spindle-at-speed kmotion.spindle-at-speed => gmoccapy.spindle_at_speed_led

# a program start begins a fresh planner segment log ([KMOTION] LOG_SEGMENTS, /tmp/TPSegLog.csv
# for the MotionLogPlotter): the file holds the last job only
net program-running halui.program.is-running => kmotion.program-running
