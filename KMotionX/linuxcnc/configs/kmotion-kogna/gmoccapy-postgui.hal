# Run by LinuxCNC after gmoccapy has made its pins ([HAL] POSTGUI_HALFILE in kmotion-kogna.ini):
# gmoccapy's spindle bar shows the spindle speed measured on the board ([KMOTION] SPINDLE_SPEED_*),
# so a spin-down shows as it happens. Its "Spindle [rpm]" label stays the commanded speed.
# With DISPLAY = axis there are no gmoccapy pins: comment POSTGUI_HALFILE out.
net spindle-rpm-measured kmotion.spindle-rpm-abs => gmoccapy.spindle_feedback_bar
# gmoccapy's at-speed light: the spindle at speed as motion uses it ([KMOTION] SPINDLE_AT_SPEED)
net spindle-at-speed kmotion.spindle-at-speed => gmoccapy.spindle_at_speed_led
