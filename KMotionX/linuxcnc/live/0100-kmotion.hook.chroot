#!/bin/sh
# live-build chroot hook: the KMotion / LinuxCNC install inside the image, as user cnc, with the
# repository's own installer (install-vm.sh --image: no VM steps). Runs as root at build time,
# with the network; takes an hour or more (LinuxCNC and KMotionX are built here).
set -e
USERNAME=cnc
PASSWORD=cnc
REPO=${KMOTIONX_REPO:-https://github.com/TomKerekes/KMotionX.git}
BRANCH=${KMOTIONX_BRANCH:-master}
echo "==== kmotion hook: user $USERNAME"
if ! id "$USERNAME" >/dev/null 2>&1; then
    useradd -m -s /bin/bash -c "LinuxCNC on KMotion" "$USERNAME"
    echo "$USERNAME:$PASSWORD" | chpasswd
fi
for g in sudo plugdev dialout input video audio netdev; do getent group $g >/dev/null && usermod -aG $g "$USERNAME"; done
# the live user's sudo without a password, as Debian's live images have it; live-config leaves the
# user alone, it exists already (the stamp), and logs it in (username= on the kernel command line)
echo "$USERNAME ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/live-$USERNAME
chmod 440 /etc/sudoers.d/live-$USERNAME
mkdir -p /var/lib/live/config && touch /var/lib/live/config/user-setup
echo "==== kmotion hook: the checkout"
HOME_DIR=$(getent passwd "$USERNAME" | cut -d: -f6)
if [ ! -d "$HOME_DIR/KMotionX/.git" ]; then
    su - "$USERNAME" -c "git clone --branch $BRANCH $REPO ~/KMotionX"
fi
echo "==== kmotion hook: install-vm.sh --image (the whole install; a long while)"
export DEBIAN_FRONTEND=noninteractive
su - "$USERNAME" -c "bash ~/KMotionX/KMotionX/linuxcnc/install/install-vm.sh --image"
echo "==== kmotion hook: VirtualBox Guest Additions (shared clipboard, window-sized display in a VM)"
# Debian 13 ships the Additions only as an ISO (virtualbox-guest-additions-iso). Only their programs
# are taken from it (VBoxService, VBoxClient: the clipboard, the display size): the kernel's own
# vboxguest module serves them, as it does on the VM this image is built on, so no modules are built
# (INSTALL_NO_MODULE_BUILDS) and no kernel headers are needed. 7z reads the ISO (bsdtar finds no
# files in it). Without a running systemd the installer puts init scripts in /etc/init.d, which
# systemd turns into units at start: vboxadd (it builds and reloads modules) is masked, vboxadd-service
# (VBoxService) starts in a VirtualBox VM only, and the session script says nothing on a real PC.
# A failure here leaves the image without the Additions, no more
(
    set +e
    apt-get install -y -q virtualbox-guest-additions-iso 7zip bzip2
    ga=/tmp/vbox-ga; rm -rf $ga; mkdir -p $ga
    7z x -y -bd -o$ga /usr/share/virtualbox/VBoxGuestAdditions.iso VBoxLinuxAdditions.run >/dev/null
    INSTALL_NO_MODULE_BUILDS=1 sh $ga/VBoxLinuxAdditions.run --nox11
    ln -sf /dev/null /etc/systemd/system/vboxadd.service
    update-rc.d -f vboxadd remove >/dev/null 2>&1
    mkdir -p /etc/systemd/system/vboxadd-service.service.d
    printf '[Unit]\nConditionVirtualization=oracle\n[Service]\nExecStartPre=-/sbin/modprobe vboxguest\n' \
        > /etc/systemd/system/vboxadd-service.service.d/kmotion.conf
    for f in /etc/X11/Xsession.d/98vboxadd-xclient /opt/VBoxGuestAdditions-*/other/98vboxadd-xclient; do
        [ -f "$f" ] && sed -i 's/^\( *\)notify-send .*/\1:   # the image: quiet on a real PC/' "$f"
    done
    if [ -x /usr/bin/VBoxClient ] && [ -x /usr/sbin/VBoxService ] && ls /lib/modules/*/kernel/drivers/virt/vboxguest/vboxguest.ko* >/dev/null 2>&1; then
        echo "   - the Additions' programs are installed, the kernel has its vboxguest module"
    else
        echo "   - the Additions are not complete: no shared clipboard in a VM"
        ls -l /usr/bin/VBoxClient /usr/sbin/VBoxService /lib/modules/*/kernel/drivers/virt/vboxguest/ 2>&1 | sed 's/^/     /'
    fi
    rm -rf $ga
    apt-get purge -y -q virtualbox-guest-additions-iso
) || true

echo "==== kmotion hook: tidying"
# the build trees' objects stay (a rebuild on the installed machine is incremental); the apt lists
# and caches go (live-build cleans the rest)
apt-get clean
# KMotionXCNC's npm packages are needed only to build its app (KMotionXCNC/kmx stays): about 1 GB
rm -rf "$HOME_DIR/KMotionXCNC/ng2/node_modules" "$HOME_DIR/KMotionXCNC/camx/node_modules" "$HOME_DIR/.npm"
rm -f /etc/sudoers.d/README 2>/dev/null || true
echo "==== kmotion hook: done"
