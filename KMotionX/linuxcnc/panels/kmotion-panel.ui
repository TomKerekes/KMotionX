<?xml version="1.0" encoding="UTF-8"?>
<!--
  kmotion-panel: KMotionCNC's buttons for a gmoccapy screen, embedded with gladevcp (see the
  [DISPLAY] EMBED_TAB_* lines of a config's ini). Each button is a HAL pin of the panel's
  component, netted to kmotion-motion in the POSTGUI_HALFILE:
    Back / Forward  hold-reverse, hold-forward: momentary - while held, and only while the
                    program is paused, the board runs its buffer backwards or forwards at
                    kmotion.hold-rate (default 0.2) of the programmed speed
    Measure         measure: appends the current position to [KMOTION] MEASURE_FILE as the
                    next grid point of a geo correction table (KMotionCNC's Measure)
    Geo reload      geo-reload: reads [KMOTION] GEO_FILE again
  kmotion-panel.py (gladevcp's -u handler) hides Geo reload without a GEO_FILE, shows Measure
  only with [KMOTION] MEASURE_BUTTON = 1, and greys Back/Forward unless kmotion.hold-allowed
-->
<interface>
  <requires lib="gtk+" version="3.20"/>
  <object class="GtkWindow" id="window1">
    <property name="can-focus">False</property>
    <property name="title">KMotion</property>
    <child>
  <object class="GtkBox" id="kmotion_panel">
    <property name="visible">True</property>
    <property name="can-focus">False</property>
    <property name="orientation">vertical</property>
    <property name="spacing">4</property>
    <property name="margin-start">4</property>
    <property name="margin-end">4</property>
    <child>
      <object class="GtkLabel" id="title">
        <property name="visible">True</property>
        <property name="can-focus">False</property>
        <property name="label">In feed hold</property>
        <attributes>
          <attribute name="weight" value="bold"/>
        </attributes>
      </object>
    </child>
    <child>
      <object class="GtkBox" id="hold_row">
        <property name="visible">True</property>
        <property name="can-focus">False</property>
        <property name="spacing">4</property>
        <property name="homogeneous">True</property>
        <child>
          <object class="HAL_Button" id="hold-reverse">
            <property name="label" translatable="yes">◀ Back</property>
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="receives-default">True</property>
            <property name="tooltip-text">While held: the paused program runs backwards</property>
          </object>
        </child>
        <child>
          <object class="HAL_Button" id="hold-forward">
            <property name="label" translatable="yes">Fwd ▶</property>
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="receives-default">True</property>
            <property name="tooltip-text">While held: the paused program runs forwards</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkBox" id="geo_row">
        <property name="visible">True</property>
        <property name="can-focus">False</property>
        <property name="spacing">4</property>
        <property name="homogeneous">True</property>
        <child>
          <object class="HAL_Button" id="measure">
            <property name="label" translatable="yes">Measure</property>
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="receives-default">True</property>
            <property name="tooltip-text">Record the current position as the next geo correction grid point</property>
          </object>
        </child>
        <child>
          <object class="HAL_Button" id="geo-reload">
            <property name="label" translatable="yes">Geo reload</property>
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="receives-default">True</property>
            <property name="tooltip-text">Read the geo correction table again</property>
          </object>
        </child>
      </object>
    </child>
  </object>
    </child>
  </object>
</interface>
