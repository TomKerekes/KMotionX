#!/usr/bin/env python3
"""clipboard-png: an image that arrives on the clipboard as a Windows bitmap only is offered as
PNG, so programs that ask for PNG (Chromium, Electron apps such as Claude Code, Firefox) can paste
it. VirtualBox's shared clipboard brings a Windows screenshot into the guest as image/bmp and
nothing else; GTK programs take that, the browser-based ones do not.

Runs in the X session (started by ~/.config/autostart/clipboard-png.desktop, which
install-desktop-icons.sh puts there). On every clipboard change: if image/bmp is offered and
image/png is not, the image is read and the clipboard taken over with an image/png form only.
Only PNG: offering a bitmap as well made VirtualBox take the contents back to the host and hand
them down again as a bitmap, round after round, until the PNG form was lost. The Windows side
keeps its own bitmap, and GTK programs paste PNG too."""
import signal
import sys

import gi
gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gtk, Gdk, GdkPixbuf, GLib   # noqa: E402

class Republisher:
    """Owns the clipboard with an image/png form only. Offering a bitmap too made VirtualBox take the
    contents back to the host and hand them down again as a bitmap, over and over; PNG alone it
    leaves be, and Windows keeps its own bitmap. GTK programs paste PNG as well."""
    def __init__(self):
        self.cb = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
        self.png = b""
        self.owner = Gtk.Invisible()
        self.owner.realize()
        Gtk.selection_add_target(self.owner, Gdk.SELECTION_CLIPBOARD, Gdk.Atom.intern("image/png", False), 0)
        self.owner.connect("selection-get", self.on_get)
        self.cb.connect("owner-change", self.on_change)
        GLib.idle_add(self.on_change, self.cb, None)   # what is on the clipboard already

    def on_change(self, cb, event):
        ok, targets = cb.wait_for_targets()
        if not ok:
            return
        names = [str(t) for t in targets]
        if "image/bmp" not in names or "image/png" in names:
            return                # no bitmap, or PNG offered already (our own contents included)
        pixbuf = cb.wait_for_image()
        if pixbuf is None:
            return
        ok, png = pixbuf.save_to_bufferv("png", [], [])
        if not ok:
            return
        self.png = bytes(png)
        if Gtk.selection_owner_set(self.owner, Gdk.SELECTION_CLIPBOARD, Gdk.CURRENT_TIME):
            print(f"clipboard-png: {pixbuf.get_width()}x{pixbuf.get_height()} bitmap offered as PNG", flush=True)

    def on_get(self, widget, selection, info, time):
        selection.set(Gdk.Atom.intern("image/png", False), 8, self.png)


def main():
    if not Gdk.Display.get_default():
        print("clipboard-png: no display", file=sys.stderr)
        return 1
    Republisher()
    signal.signal(signal.SIGINT, signal.SIG_DFL)
    signal.signal(signal.SIGTERM, lambda *_: Gtk.main_quit())
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main())
